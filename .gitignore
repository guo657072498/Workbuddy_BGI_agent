# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 构建中间产物 ----
# 注意：根目录的 dist/ 是通用构建输出，忽略
# 任务内的 dist/ 是交付物（exe 等），必须入库，所以这里加 / 锁定只匹配根目录
/dist/
build/

# ---- 任务运行产物（可由代码或输入重新生成，不入库）----
# 规范约定：成品只能放 dist/（代码类）或 deliverables/（文档类）
# 放在这些目录里的一律视为过程产物
# 注意：只匹配 tasks/ 下的一层任务目录，不匹配任意层级。
# 原因：output/ 是通用名，任意层级匹配会静默吞掉将来叫 output 的交付物。
# 例：tasks/20261026-udi-xml-tool/output/ ✓ 被忽略
#     tasks/xxx/deliverables/output/        ✗ 不受影响
tasks/*/_out/
tasks/*/output/
tasks/*/输出结果/
# dist/ 里只该有成品 exe，混进来的运行结果目录一并忽略
# （实测：从 dist 里运行 exe 会生成 dist/输出结果/，这属于运行产物不是交付物）
tasks/*/dist/输出结果/
# exe / 源码运行时生成的主数据（用户自己维护的内容，不入库）
tasks/*/主数据/
tasks/*/dist/主数据/

# ---- 环境变量与密钥（严禁提交）----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json
token.json
*_credentials.*

# ---- 日志与临时文件 ----
*.log
logs/
tmp/
temp/
*.tmp
*.bak
~$*
*.stackdump

# ---- 办公类临时文件 ----
.~lock.*#

# ---- WorkBuddy 本地运行时 ----
# 白名单模式：只保留 memory（长期笔记），其余一律忽略
# 这样将来新增 logs/、state/、index/ 等目录也不会被静默入库
.workbuddy/*
!.workbuddy/memory/
!.workbuddy/memory/**
