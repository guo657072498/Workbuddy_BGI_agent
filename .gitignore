# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---- Node.js ----
node_modules/
dist/
build/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 环境变量与密钥（严禁提交）----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json
token.json
*_credentials.*

# ---- 日志与临时文件 ----
*.log
logs/
tmp/
temp/
*.tmp
*.bak
~$*

# ---- 办公类临时文件 ----
*.stackdump
.~lock.*#

# ---- WorkBuddy 本地运行时（保留 memory，忽略缓存）----
.workbuddy/cache/
.workbuddy/tmp/
.workbuddy/sessions/
